# Copy to .env and adjust as needed. Every variable is optional; the defaults
# below match what the application uses when nothing is set.

# SQLAlchemy database URL. SQLite by default; PostgreSQL URLs work unchanged.
CFM_DATABASE_URL=sqlite:///./cfm.db
# CFM_DATABASE_URL=postgresql+psycopg://cfm:cfm@localhost:5432/cfm

# Run pending database migrations automatically at startup. Off by default:
# the application instead refuses to start when the schema is not at the
# head revision and prints the command to run.
CFM_DB_AUTO_UPGRADE=false

# Serve the interactive OpenAPI pages at /docs and /redoc.
CFM_DOCS_ENABLED=true

# JSON array of origins allowed to call the API from a browser.
CFM_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Throttling of failed token authentications, counted per network source.
# After CFM_AUTH_MAX_FAILURES failures within
# CFM_AUTH_FAILURE_WINDOW_SECONDS, the source receives 429 (with a
# Retry-After header) for CFM_AUTH_LOCKOUT_SECONDS. Zero max failures
# disables the limiter.
CFM_AUTH_MAX_FAILURES=10
CFM_AUTH_FAILURE_WINDOW_SECONDS=60
CFM_AUTH_LOCKOUT_SECONDS=300

# Trust exactly one operator-controlled reverse proxy in front of the app:
# attribute authentication failures to the rightmost X-Forwarded-For entry
# (the address the proxy appended) instead of the socket peer. Leave false
# unless such a proxy really is there — the header is client-writable.
CFM_TRUSTED_PROXY=false
